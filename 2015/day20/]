def getFactorPerm(factors):
    fperm = []

    if len(factors) == 1:
        return factors

    print("factors", factors)
    fperm += [[factors[0]] + getFactorPerm(factors[1:])]
    fperm += [getFactorPerm(factors[1:])]

    # convert to factor
    ffactors = []
    for fset in fperm:
        ffactors.append(math.prod(fset))
    return ffactors


def main(house):

    print("====> Solve for", house)
    # get factors of house number
    factors = []
    i = 1
    while i < house:
        i += 1
        print(i)
        if (house % i) == 0:
            print("factor", i)
            factors.append(i)
            house = house / i
            i = 1

    print(factors)
    fp = getFactorPerm(factors)
    score = 10
    fm = 1
    for f in fp:
        if fm is None:
            fm = f
        else:
            fm *= f
        score += fm * 10
    print("Score", score)
    return score


